NODE_ENV=development
PORT=3001

# PostgreSQL connection string. Use the provider's SSL-enabled URL in production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/life

# Comma-separated exact frontend origins; no wildcard when credentials are enabled.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Generate a long random value and keep it private.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Required only when running `npm run admin:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Administrator

# Optional outbound email settings for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
